# ==========================================
# VisualCrypto Environment Configuration
# ==========================================

# Server Host and Port
HOST=0.0.0.0
PORT=5000

# Flask Debug Mode (Set to false for production!)
FLASK_DEBUG=false

# Security Secret Key (Generate a random 32-byte hex string in production)
SECRET_KEY=replace-with-a-secure-random-key-in-production

# Maximum Upload File Size Limit in Megabytes (Default: 16 MB)
MAX_CONTENT_LENGTH_MB=16

# Automatic File Cleanup: Maximum age in seconds before orphaned uploads/outputs are purged (Default: 3600 = 1 hour)
FILE_CLEANUP_MAX_AGE_SECONDS=3600
